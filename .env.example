# ---- Clerk (required for auth) ----
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ---- Admin access (comma-separated emails; defaults include skilledgelearning@gmail.com) ----
NEXT_PUBLIC_ADMIN_EMAILS=skilledgelearning@gmail.com

# ---- Google AdSense (owner's account — ads show to FREE users only) ----
# Publisher ID from https://adsense.google.com → Account → Settings
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# Ad unit slot id (create a Display ad unit in AdSense → Ads → By ad unit)
NEXT_PUBLIC_ADSENSE_SLOT_DEFAULT=1234567890

# ---- Razorpay (activates gateway checkout on /pricing) ----
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...

# ---- Stripe (optional international payments) ----
STRIPE_SECRET_KEY=sk_test_...
